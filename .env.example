# Server Configuration
HOST=127.0.0.1
PORT=8000

# Worker & Resource Constraints
WORKER_CONCURRENCY=1
STORAGE_DIR=experiments_storage
MAX_CONCURRENT_JOBS=1

# Optional API Security & Authentication
# If set, modifying/creating experiments requires 'X-API-Key' header matching this secret
API_AUTH_KEY=

# Logging & Conic Solvers
DEFAULT_SOLVER=CLARABEL
LOG_LEVEL=INFO
